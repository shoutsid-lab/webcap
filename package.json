{
  "name": "webcap",
  "version": "0.1.0",
  "description": "Web Capture API - URL to PNG/JPEG/PDF + OG link preview, metered in credits, paid with on-chain USDC (Base)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "chain:up": "tsx scripts/devchain.ts"
  },
  "dependencies": {
    "@x402/axios": "^2.25.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/fastify": "^2.25.0",
    "better-sqlite3": "^12.0.0",
    "ethers": "^6.13.4",
    "fastify": "^5.1.0",
    "playwright-core": "^1.53.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
