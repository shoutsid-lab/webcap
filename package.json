{
  "name": "webcap",
  "version": "0.1.0",
  "description": "Web Capture API - URL to PNG/JPEG/PDF + OG link preview, metered in credits, paid with on-chain USDC (Base)",
  "type": "module",
  "engines": { "node": ">=24" },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "chain:up": "tsx scripts/devchain.ts",
    "chain:usdc:deploy": "tsx scripts/deploy-usdc.ts",
    "chain:pay": "tsx scripts/pay-invoice.ts",
    "chain:verify": "tsx scripts/verify-chain.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "ethers": "^6.13.4",
    "fastify": "^5.1.0",
    "playwright-core": "^1.53.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
