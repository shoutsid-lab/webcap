# webcap environment (copy to .env and fill in)

# Chain: base | base-sepolia | local
#   base         -> Base mainnet USDC  (LIVE, real money)
#   base-sepolia -> Base Sepolia USDC  (testnet)
#   local        -> local Anvil + mintable USDC (deterministic tests / local surface)
WEBCAP_CHAIN=local

# HTTP port
WEBCAP_PORT=8080

# Merchant self-custody EOA private key (0x-prefixed 32-byte hex). The webcap
# server RECEIVES USDC to this address. Never commit a real key. In local mode
# scripts/devchain.ts generates one and prints it.
USDC_MERCHANT_PRIVATE_KEY=

# Only used when WEBCAP_CHAIN=local: address of the mintable USDC deployed by
# scripts/devchain.ts (written to /tmp/webcap-chain.json).
LOCAL_USDC_CONTRACT=

# Poller cadence in ms. Keep small (<=1000) for tests, 30000-60000 for live.
POLL_INTERVAL_MS=5000

# Database file (WAL). Relative paths resolve from the project root.
WEBCAP_DB_PATH=./data/webcap.db
