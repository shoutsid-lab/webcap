# webcap — production environment
# Copy this to <repo>/.env (the compose `env_file`) or set it in your PaaS env.
# NO real secrets in this template — fill in the live values on the host only.

# Chain: base-sepolia (testnet) | base (mainnet = REAL money) | local (disables x402)
WEBCAP_CHAIN=base-sepolia

# Merchant: the self-custody EOA that RECEIVES the x402 USDC.
# Set EITHER USDC_MERCHANT_PRIVATE_KEY (address is derived) OR WEBCAP_MERCHANT_ADDRESS.
# Keep the private key ONLY in the live .env (chmod 600) — never commit it.
USDC_MERCHANT_PRIVATE_KEY=
# WEBCAP_MERCHANT_ADDRESS=0x...

# x402 per-request price in USDC (human USDC; stored as 6-decimal units internally).
WEBCAP_X402_PRICE_USDC=0.001

# x402 facilitator (verifies + settles the on-chain transfer; it pays gas, the payer is gasless):
#   base-sepolia (testnet): https://x402.org/facilitator                          (no key)
#   base (mainnet, real money): https://api.cdp.coinbase.com/platform/v2/x402      (needs a CDP key)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional overrides (defaults: the chain's USDC / the merchant address)
# WEBCAP_X402_ASSET=
# WEBCAP_X402_PAY_TO=

# HTTP port (compose maps 8080:8080)
WEBCAP_PORT=8080

# Poller cadence (ms) for the credit-based /v1/capture path (the x402 path settles per-request)
POLL_INTERVAL_MS=30000
